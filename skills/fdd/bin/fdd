#!/usr/bin/env bash
# fdd: small helpers for Fast Driven Development.
#
# Snapshots are commits no branch points at, kept by per-worktree refs under
# refs/worktree/fdd/<n>. Each one is built in a throwaway index, so HEAD, branches
# and the staging area are never touched. Ignored files and files that look like
# secrets are never saved and never written back.
#
# Runs on the bash 3.2 that ships with macOS.
set -u

REF_ROOT="refs/worktree/fdd"
# Never saved, even when .gitignore misses them. Matched in any case.
SECRET_GLOBS=(
  '**/.env*' '**/*.pem' '**/*.key' '**/*.p8' '**/*.p12' '**/*.pfx'
  '**/id_rsa*' '**/id_dsa*' '**/id_ecdsa*' '**/id_ed25519*'
  '**/.netrc' '**/.npmrc' '**/.pypirc' '**/credentials.json' '**/secrets.json'
)
# Untracked files over this size are not saved: a video export would make every
# hook copy gigabytes into .git.
MAX_FILE_MB="${FDD_MAX_FILE_MB:-100}"

die() { printf 'fdd: %s\n' "$*" >&2; exit 1; }
say() { [ "${FDD_QUIET:-0}" = 1 ] || printf '%s\n' "$*"; }

usage() {
  cat <<'EOF'
fdd: helpers for Fast Driven Development

  fdd snapshot [label]   save the working tree as a state (no-op when unchanged)
  fdd undo               put the files back as they were one state before
  fdd redo               go forward again after an undo
  fdd goto <n>           put the files back as they were in state #n
  fdd history [--clear]  list the states; --clear forgets them all
  fdd commit "type(scope): summary" [--body text] [--push] [-- paths]
                         Conventional Commit of what is staged, after a secret
                         scan; no Claude attribution; never pushes unless --push
  fdd statusline         context meter in tokens for Claude Code's status line
  fdd hook [--warn-only] entry point for Claude Code hooks (reads their JSON on stdin);
                         --warn-only only warns about context, never snapshots
  fdd setup --user [--dry-run] [--yes] [--remove]
                         turn the context meter on in ~/.claude/settings.json,
                         backup first; --remove takes it out again

Undo moves files only. HEAD, branches and what you staged stay as they are.
Ignored files, secret-looking files (.env*, keys, .netrc, credentials.json...)
and untracked files over FDD_MAX_FILE_MB (100) are never saved and never written.
EOF
}

# --- repository ---------------------------------------------------------------

# 0 inside a work tree (and cd to its top), 1 outside one, 2 when GIT_DIR is set
# alone: git would then take the current folder as the top of the tree.
in_repo() {
  local top
  if [ -n "${GIT_DIR:-}" ] && [ -z "${GIT_WORK_TREE:-}" ]; then
    printf 'fdd: GIT_DIR is set without GIT_WORK_TREE; set both, or unset GIT_DIR\n' >&2
    return 2
  fi
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
  cd "$top" || return 1
}

git_path() { git rev-parse --git-path "$1"; }

secret_excludes() {
  local g
  for g in "${SECRET_GLOBS[@]}"; do printf ':(exclude,glob,icase)%s\n' "$g"; done
}
secret_pathspecs() {
  local g
  for g in "${SECRET_GLOBS[@]}"; do printf ':(glob,icase)%s\n' "$g"; done
}

lock_dir=""
take_lock() {
  local owner
  lock_dir="$(git_path fdd.lock)"
  # A lock whose process is gone is left over from a killed run.
  if [ -d "$lock_dir" ]; then
    owner="$(cat "$lock_dir/pid" 2>/dev/null)"
    if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
      rm -f "$lock_dir/pid" && rmdir "$lock_dir" 2>/dev/null
    elif [ -z "$owner" ] && [ -n "$(find "$lock_dir" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then
      rmdir "$lock_dir" 2>/dev/null
    fi
  fi
  if ! mkdir "$lock_dir" 2>/dev/null; then
    lock_dir=""
    return 1
  fi
  printf '%s\n' "$$" >"$lock_dir/pid"
  trap 'release_lock' EXIT
  trap 'release_lock; exit 130' INT TERM
}
release_lock() {
  [ -n "$lock_dir" ] && rm -f "$lock_dir/pid" && rmdir "$lock_dir" 2>/dev/null
  lock_dir=""
}

# The working tree as a tree object, built in a throwaway index.
worktree_tree() {
  local idx real tree excludes=() line
  while IFS= read -r line; do excludes+=("$line"); done <<EOF
$(secret_excludes)
EOF
  idx="$(mktemp "$(git_path fdd-index).XXXXXX")" || return 1
  real="$(git_path index)"
  # Starting from a copy of the real index keeps git's stat cache, so only
  # changed files are hashed. A missing index must not be an empty file.
  if [ -f "$real" ]; then cp -p "$real" "$idx"; else rm -f "$idx"; fi
  if ! tree="$(build_tree "$idx" "${excludes[@]}")"; then
    # A copy taken mid-merge holds unmerged entries: start over from HEAD.
    rm -f "$idx"
    git rev-parse -q --verify HEAD >/dev/null && GIT_INDEX_FILE="$idx" git read-tree HEAD
    tree="$(build_tree "$idx" "${excludes[@]}")" || { rm -f "$idx"; return 1; }
  fi
  rm -f "$idx"
  printf '%s\n' "$tree"
}

build_tree() {
  local idx="$1" globs=() big=() line
  shift
  while IFS= read -r line; do globs+=("$line"); done <<EOF
$(secret_pathspecs)
EOF
  while IFS= read -r -d '' line; do
    printf 'fdd: not saved, over %s MB: %s\n' "$MAX_FILE_MB" "$line" >&2
    big+=(":(exclude,literal)$line")
  done < <(GIT_INDEX_FILE="$idx" git ls-files -z -o --exclude-standard -- . "$@" 2>/dev/null |
    MAX="$MAX_FILE_MB" perl -0ne 'chomp; print "$_\0" if -f $_ && !-l $_ && -s _ > $ENV{MAX} * 1048576')
  GIT_INDEX_FILE="$idx" git add -A -- . "$@" ${big[@]+"${big[@]}"} >/dev/null 2>&1 || return 1
  # Tracked secret files come in with the copied index: take them out too.
  GIT_INDEX_FILE="$idx" git rm --cached -r -q --ignore-unmatch -- "${globs[@]}" >/dev/null 2>&1 || return 1
  GIT_INDEX_FILE="$idx" git write-tree 2>/dev/null
}

# --- states -------------------------------------------------------------------

numbers() {
  git for-each-ref --format='%(refname:lstrip=3)' "$REF_ROOT/" | grep -E '^[0-9]+$' | sort -n
}

commit_of() { git rev-parse -q --verify "$REF_ROOT/$1^{commit}" 2>/dev/null; }
tree_of() { git rev-parse -q --verify "$REF_ROOT/$1^{tree}" 2>/dev/null; }
label_of() { git log -1 --format=%s "$REF_ROOT/$1"; }

number_of_commit() {
  git for-each-ref --points-at "$1" --format='%(refname:lstrip=3)' "$REF_ROOT/" | grep -E '^[0-9]+$' | head -1
}

parent_of() {
  local p
  p="$(git rev-parse -q --verify "$REF_ROOT/$1^1" 2>/dev/null)" || return 0
  number_of_commit "$p"
}

cursor() {
  local f n
  f="$(git_path fdd-cursor)"
  if [ -f "$f" ]; then
    n="$(cat "$f")"
    if [ -n "$(commit_of "$n")" ]; then printf '%s\n' "$n"; return; fi
  fi
  numbers | tail -1
}

set_cursor() { printf '%s\n' "$1" >"$(git_path fdd-cursor)"; }

# Save $2 (a tree) as a new state labelled $1, child of the cursor. Prints its number.
save_state() {
  local label="$1" tree="$2" cur parent=() n commit
  cur="$(cursor)"
  [ -n "$cur" ] && parent=(-p "$(commit_of "$cur")")
  n=$(( $(numbers | tail -1 | sed 's/^$/0/') + 1 ))
  commit="$(printf '%s\n' "$label" | GIT_AUTHOR_NAME=fdd GIT_AUTHOR_EMAIL=fdd@localhost \
    GIT_COMMITTER_NAME=fdd GIT_COMMITTER_EMAIL=fdd@localhost git commit-tree "$tree" ${parent[@]+"${parent[@]}"})" || return 1
  git update-ref "$REF_ROOT/$n" "$commit" || return 1
  set_cursor "$n"
  printf '%s\n' "$n"
}

# Move the working tree from tree $1 to tree $2. Refuses, moving nothing, when it
# would write over a file no state holds (an ignored or excluded one).
move_files() {
  local from="$1" to="$2" idx path dir sub blocked=0
  # git read-tree -u writes over an ignored file at a path the target adds, so
  # check every added path (and its folders) against the disk first. What the
  # current state holds there (a file that becomes a folder, or back) may go.
  while IFS= read -r -d '' path; do
    if [ -d "$path" ] && [ ! -L "$path" ] && git cat-file -e "$from:$path" 2>/dev/null; then
      while IFS= read -r -d '' sub; do
        if ! git cat-file -e "$from:$sub" 2>/dev/null; then
          printf '  %s\n' "$sub" >&2
          blocked=1
        fi
      done < <(find "$path" \( -type f -o -type l \) -print0)
      continue
    fi
    if [ -e "$path" ] || [ -L "$path" ]; then
      printf '  %s\n' "$path" >&2
      blocked=1
      continue
    fi
    dir="$(dirname "$path")"
    while [ "$dir" != "." ]; do
      if { [ -e "$dir" ] || [ -L "$dir" ]; } && [ ! -d "$dir" ] && ! git cat-file -e "$from:$dir" 2>/dev/null; then
        printf '  %s\n' "$dir" >&2
        blocked=1
        break
      fi
      dir="$(dirname "$dir")"
    done
  done < <(git diff-tree -r -z --no-renames --diff-filter=A --name-only "$from" "$to")
  [ "$blocked" = 0 ] || return 1
  idx="$(mktemp "$(git_path fdd-index).XXXXXX")" || return 1
  rm -f "$idx"
  GIT_INDEX_FILE="$idx" git read-tree "$from" &&
    GIT_INDEX_FILE="$idx" git update-index -q --refresh >/dev/null 2>&1
  if ! GIT_INDEX_FILE="$idx" git read-tree -m -u "$from" "$to" 2>"$idx.err"; then
    sed 's/^/  /' "$idx.err" >&2
    rm -f "$idx" "$idx.err"
    return 1
  fi
  rm -f "$idx" "$idx.err"
}

describe() { printf '#%s (%s)' "$1" "$(label_of "$1")"; }

# Before any jump: hand edits since the cursor become a state of their own.
keep_changes() {
  local tree="$1" cur="$2" n
  if [ -n "$cur" ] && [ "$tree" != "$(tree_of "$cur")" ]; then
    n="$(save_state "your changes, kept before a jump" "$tree")" || die "could not save your changes; nothing moved"
    say "Your changes since $(describe "$cur") are kept as #$n." >&2
    printf '%s\n' "$n"
    return
  fi
  printf '%s\n' "$cur"
}

jump() {
  local to="$1" from_tree="$2"
  if ! move_files "$from_tree" "$(tree_of "$to")"; then
    die "nothing moved: that would write over a file no state holds (ignored or secret). Move it away and retry."
  fi
  set_cursor "$to"
}

# --- commands -----------------------------------------------------------------

cmd_snapshot() {
  local label="${1:-snapshot}" tree cur n rc=0
  in_repo || rc=$?
  [ "$rc" = 2 ] && exit 1
  if [ "$rc" != 0 ]; then
    say "fdd: not a git repository; nothing saved."
    return 0
  fi
  take_lock || { say "fdd: another fdd run is busy; skipped."; return 0; }
  tree="$(worktree_tree)" || die "could not read the working tree"
  cur="$(cursor)"
  if [ -n "$cur" ] && [ "$tree" = "$(tree_of "$cur")" ]; then
    say "No changes since $(describe "$cur")."
    return 0
  fi
  n="$(save_state "$label" "$tree")" || die "could not save the snapshot"
  say "Saved #$n."
}

cmd_undo() {
  local tree cur target
  in_repo || { [ $? = 2 ] && exit 1; die "not a git repository"; }
  take_lock || die "another fdd run is busy; try again"
  cur="$(cursor)"
  [ -n "$cur" ] || die "nothing to undo: no states yet"
  tree="$(worktree_tree)" || die "could not read the working tree"
  if [ "$tree" != "$(tree_of "$cur")" ]; then
    keep_changes "$tree" "$cur" >/dev/null || exit 1
    target="$cur"
  else
    target="$(parent_of "$cur")"
    while [ -n "$target" ] && [ "$(tree_of "$target")" = "$tree" ]; do target="$(parent_of "$target")"; done
    [ -n "$target" ] || die "nothing to undo: $(describe "$cur") is the first state"
  fi
  jump "$target" "$tree"
  say "Files are back at $(describe "$target"). fdd redo goes forward again."
}

cmd_redo() {
  local tree cur cur_commit n child=""
  in_repo || { [ $? = 2 ] && exit 1; die "not a git repository"; }
  take_lock || die "another fdd run is busy; try again"
  cur="$(cursor)"
  [ -n "$cur" ] || die "nothing to redo: no states yet"
  tree="$(worktree_tree)" || die "could not read the working tree"
  if [ "$tree" != "$(tree_of "$cur")" ]; then
    n="$(keep_changes "$tree" "$cur")" || exit 1
    die "nothing to redo: files changed since $(describe "$cur"); they are kept as #$n"
  fi
  cur_commit="$(commit_of "$cur")"
  # The newest state that came from the cursor.
  for n in $(numbers | sort -rn); do
    if [ "$(git rev-parse -q --verify "$REF_ROOT/$n^1" 2>/dev/null)" = "$cur_commit" ]; then
      child="$n"
      break
    fi
  done
  [ -n "$child" ] || die "nothing to redo"
  jump "$child" "$tree"
  say "Files are at $(describe "$child")."
}

cmd_goto() {
  local to="${1:-}" tree cur
  in_repo || { [ $? = 2 ] && exit 1; die "not a git repository"; }
  [ -n "$to" ] && [ -n "$(commit_of "$to")" ] || die "no state #${to:-?}; see fdd history"
  take_lock || die "another fdd run is busy; try again"
  tree="$(worktree_tree)" || die "could not read the working tree"
  cur="$(cursor)"
  keep_changes "$tree" "$cur" >/dev/null || exit 1
  jump "$to" "$tree"
  say "Files are at $(describe "$to")."
}

cmd_history() {
  local cur n mark parent files
  in_repo || { [ $? = 2 ] && exit 1; die "not a git repository"; }
  if [ "${1:-}" = "--clear" ]; then
    for n in $(numbers); do git update-ref -d "$REF_ROOT/$n"; done
    rm -f "$(git_path fdd-cursor)"
    say "All states forgotten. Your files did not change."
    return 0
  fi
  cur="$(cursor)"
  [ -n "$cur" ] || { say "No states yet."; return 0; }
  for n in $(numbers | sort -rn); do
    mark=" "
    [ "$n" = "$cur" ] && mark="*"
    parent="$(git rev-parse -q --verify "$REF_ROOT/$n^1" 2>/dev/null)"
    if [ -n "$parent" ]; then
      files="$(git diff --name-only "$parent" "$REF_ROOT/$n" | wc -l | tr -d ' ')"
    else
      files="$(git ls-tree -r --name-only "$REF_ROOT/$n" | wc -l | tr -d ' ')"
    fi
    printf '%s #%-4s %-14s %3s files  %s\n' "$mark" "$n" "$(git log -1 --format=%cr "$REF_ROOT/$n")" "$files" "$(label_of "$n")"
  done
  say "* marks where your files are. fdd undo / fdd redo / fdd goto <n>."
}

# --- commit -------------------------------------------------------------------

COMMIT_TYPES="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"

# Files whose staged lines hold a secret, one per line. gitleaks when it is
# installed (the scanner CI runs), plus a short list of well-known shapes.
# Only file names are printed, never the matching text.
staged_secrets() {
  local leaks="${FDD_GITLEAKS:-}" report
  [ -z "$leaks" ] && leaks="$(command -v gitleaks 2>/dev/null)"
  if [ -n "$leaks" ] && [ "$leaks" != none ]; then
    report="$(mktemp "${TMPDIR:-/tmp}/fdd-leaks.XXXXXX")" || return 2
    if "$leaks" git --help >/dev/null 2>&1; then
      "$leaks" git --staged --no-banner --redact --report-format json --report-path "$report" . >/dev/null 2>&1
    else
      "$leaks" protect --staged --no-banner --redact --report-format json --report-path "$report" >/dev/null 2>&1
    fi
    perl -MJSON::PP -e 'local $/; my $j = eval { JSON::PP->new->decode(<>) } || []; my %s; $s{$_->{File} // "(a staged file)"}++ for @$j; print "$_\n" for sort keys %s' "$report" 2>/dev/null
    rm -f "$report"
  fi
  # Always, so a gitleaks that errors out still leaves a scan behind.
  git -c core.quotePath=false diff --cached -U0 --no-color --no-ext-diff --src-prefix=a/ --dst-prefix=b/ | perl -ne '
    BEGIN { our %hit; our $f = "(a staged file)" }
    if (/^\+\+\+ (?:"b\/(.*)"|b\/(.*))$/) { $f = defined $1 ? $1 : $2; next }
    next if /^\+\+\+ /;
    next unless /^\+/;
    $hit{$f}++ if /(sk-ant-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{32,}|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}|xox[abprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{35}|-----BEGIN [A-Z ]*PRIVATE KEY-----)/;
    END { print "$_\n" for sort keys %hit }'
}

cmd_commit() {
  local subject="" body="" push=0 paths=() secret_files=() globs=() msg coauthor sha branch line
  while [ $# -gt 0 ]; do
    case "$1" in
      --body) [ $# -ge 2 ] || die "--body needs a text"; body="$2"; shift 2 ;;
      --push) push=1; shift ;;
      --) shift; paths=("$@"); break ;;
      -*) die "unknown option $1" ;;
      *) [ -z "$subject" ] || die "one message only; put the rest in --body"; subject="$1"; shift ;;
    esac
  done
  in_repo || { [ $? = 2 ] && exit 1; die "not a git repository"; }
  [ -n "$subject" ] || die 'usage: fdd commit "type(scope): summary" [--body text] [--push] [-- paths]'
  printf '%s\n' "$subject" | grep -Eq "^($COMMIT_TYPES)(\([A-Za-z0-9._/-]+\))?!?: [^ ]" ||
    die "not a Conventional Commit: \"$subject\". Use type(scope): summary, type one of ${COMMIT_TYPES//|/, }"
  [ "${#subject}" -le 72 ] || die "the summary is ${#subject} characters; keep it at 72 or less"

  if [ ${#paths[@]} -gt 0 ]; then
    git add -A -- "${paths[@]}" || die "could not stage ${paths[*]}"
  fi
  git diff --cached --quiet && die "nothing staged; git add the files of this commit, or pass them after --"

  while IFS= read -r line; do globs+=("$line"); done <<EOF
$(secret_pathspecs)
EOF
  while IFS= read -r line; do [ -n "$line" ] && secret_files+=("$line"); done <<EOF
$(git -c core.quotePath=false diff --cached --name-only -- "${globs[@]}")
$(staged_secrets)
EOF
  if [ ${#secret_files[@]} -gt 0 ]; then
    printf 'fdd: refusing to commit: a secret, or a file that holds secrets, is staged in:\n' >&2
    printf '  %s\n' "${secret_files[@]}" | LC_ALL=C sort -u >&2
    die "unstage it (git restore --staged <file>), move the secret to an env var, and retry"
  fi

  msg="$(mktemp "${TMPDIR:-/tmp}/fdd-msg.XXXXXX")" || die "could not write the message"
  # Only attribution lines go: a subject or a sentence that mentions Claude stays.
  {
    printf '%s\n' "$subject"
    [ -n "$body" ] && printf '\n%s\n' "$body" |
      LC_ALL=C grep -viE '^[[:space:]]*(co-authored-by:.*(claude|anthropic)|claude-session:|([^[:alnum:][:space:]]+[[:space:]]*)?generated with \[claude code\]|https?://claude\.ai/code[^[:space:]]*[[:space:]]*$)'
  } >"$msg"
  coauthor="$(git config --get fdd.coauthor 2>/dev/null)"
  if [ -n "$coauthor" ] && ! grep -qxF "Co-Authored-By: $coauthor" "$msg"; then
    printf '\nCo-Authored-By: %s\n' "$coauthor" >>"$msg"
  fi
  if ! git commit -q --cleanup=whitespace -F "$msg"; then
    rm -f "$msg"
    die "git commit failed; nothing was committed"
  fi
  rm -f "$msg"
  sha="$(git rev-parse --short HEAD)"
  branch="$(git branch --show-current)"
  say "Committed $sha on ${branch:-a detached HEAD}: $subject"
  case "$branch" in main|master) say "Note: that is $branch. FDD works on a branch and merges by PR." ;; esac
  if [ "$push" = 1 ]; then
    [ -n "$branch" ] || die "detached HEAD: the commit is kept; push it to a branch by hand"
    git push -q -u origin HEAD || die "push failed; the commit is kept locally"
    say "Pushed to origin/$branch."
  else
    say "Not pushed. git push when you are ready, or fdd commit --push next time."
  fi
}

# --- context ------------------------------------------------------------------

# Every message re-sends the whole context, so the meter counts tokens, not a
# share of the window: on a 1M window 18% is already 182k tokens a message. The
# thresholds are the lower of these and half / three quarters of the window,
# which keeps 100k / 150k on a 200k window.
FDD_WARN_TOKENS=150000
FDD_STOP_TOKENS=250000

# Claude Code hands the status line the context figures; hooks get none. The
# status line keeps "tokens size" per session (size 0 when unknown) so the prompt
# hook can warn once per level. Never reads a transcript.
context_file() {
  local sid="$1"
  case "$sid" in ""|*[!A-Za-z0-9_-]*) return 1 ;; esac
  printf '%s/fdd-context-%s\n' "${TMPDIR:-/tmp}" "$sid"
}

# Sets ctx_k (the shown thousands), ctx_level (0, 1 or 2) from tokens $1 and
# window size $2 (0 when unknown). The level comes from the shown figure, so
# "150k" is never dim.
context_level() {
  local tokens="$1" size="$2" warn="$FDD_WARN_TOKENS" stop="$FDD_STOP_TOKENS" shown
  if [ "$size" -gt 0 ]; then
    [ $((size / 2)) -lt "$warn" ] && warn=$((size / 2))
    [ $((size * 3 / 4)) -lt "$stop" ] && stop=$((size * 3 / 4))
  fi
  ctx_k=$((tokens / 1000))
  shown=$((ctx_k * 1000))
  ctx_level=0
  [ "$shown" -ge "$warn" ] && ctx_level=1
  [ "$shown" -ge "$stop" ] && ctx_level=2
  return 0
}

cmd_statusline() {
  local parsed sid tokens size pct file colour advice
  parsed="$(perl -MJSON::PP -e '
    use Scalar::Util qw(looks_like_number);
    local $/; my $j = eval { JSON::PP->new->decode(<STDIN>) } or exit 0;
    ref $j eq "HASH" or exit 0;
    my $c = ref $j->{context_window} eq "HASH" ? $j->{context_window} : {};
    sub num { my $v = shift; return (defined $v && !ref $v && looks_like_number($v) && $v >= 0 && $v < 1e15) ? $v : undef }
    my $size = num($c->{context_window_size});
    $size = undef unless $size;
    my $p = num($c->{used_percentage});
    $p = undef if defined $p && $p > 100;
    my $t = num($c->{total_input_tokens});
    $t = undef unless $t;
    if (!defined $t && ref $c->{current_usage} eq "HASH") {
      my $u = $c->{current_usage}; my $sum = 0;
      $sum += num($u->{$_}) // 0 for qw(input_tokens cache_creation_input_tokens cache_read_input_tokens);
      $t = $sum if $sum > 0;
    }
    $t = $p * $size / 100 if !defined $t && defined $p && defined $size;
    print join("\n", $j->{session_id} // "", defined $t ? int($t) : "", defined $size ? int($size) : 0,
      defined $p ? int($p + 0.5) : ""), "\n";
  ' 2>/dev/null)" || return 0
  sid="$(printf '%s\n' "$parsed" | sed -n 1p)"
  tokens="$(printf '%s\n' "$parsed" | sed -n 2p)"
  size="$(printf '%s\n' "$parsed" | sed -n 3p)"
  pct="$(printf '%s\n' "$parsed" | sed -n 4p)"
  case "$size" in ""|*[!0-9]*) size=0 ;; esac
  file="$(context_file "$sid")" || file=""
  case "$tokens" in
    ""|*[!0-9]*)
      # No token figure: today's percentage, its 50/75 split, and a dim "?".
      [ -n "$file" ] && rm -f "$file" 2>/dev/null
      case "$pct" in ""|*[!0-9]*) return 0 ;; esac
      if [ "$pct" -ge 75 ]; then
        printf '\033[31mcontext %s%% · new session\033[0m \033[2m?\033[0m\n' "$pct"
      elif [ "$pct" -ge 50 ]; then
        printf '\033[33mcontext %s%% · finish this task\033[0m \033[2m?\033[0m\n' "$pct"
      else
        printf '\033[2mcontext %s%% ?\033[0m\n' "$pct"
      fi
      return 0
      ;;
  esac
  if [ -n "$file" ]; then
    printf '%s %s\n' "$tokens" "$size" >"$file.$$" 2>/dev/null && mv -f "$file.$$" "$file" 2>/dev/null
  fi
  context_level "$tokens" "$size"
  case "$ctx_level" in
    2) colour=31 advice=" · new session" ;;
    1) colour=33 advice=" · finish this task" ;;
    *) colour=2 advice="" ;;
  esac
  printf '\033[%smcontext %sk%s\033[0m\n' "$colour" "$ctx_k" "$advice"
}

# Print a hook warning as JSON when the context reached a level not warned yet.
# The markers are directories: mkdir is atomic, so a user-level and a
# project-level hook on the same prompt print one warning between them.
context_warning() {
  local file reading tokens size human model
  file="$(context_file "$1")" || return 0
  reading="$(cat "$file" 2>/dev/null)"
  # An old one-number file, or anything else, is no reading.
  case "$reading" in *" "*) ;; *) return 0 ;; esac
  tokens="${reading%% *}"
  size="${reading#* }"
  case "$tokens" in ""|*[!0-9]*) return 0 ;; esac
  case "$size" in ""|*[!0-9]*) return 0 ;; esac
  context_level "$tokens" "$size"
  case "$ctx_level" in
    0)
      rmdir "$file.w2" "$file.w1" 2>/dev/null
      return 0
      ;;
    2)
      mkdir "$file.w2" 2>/dev/null || return 0
      # A later drop into the level 1 band must not warn about level 1.
      mkdir "$file.w1" 2>/dev/null
      human="Context is at ${ctx_k}k tokens. Finish this task, then type /clear and start fresh."
      model="The context is at ${ctx_k}k tokens. Finish the current task only. Write where it stands in the note's Next line; if there is no note, give the human a summary of at most 5 lines to paste after /clear. Then tell the human to type /clear."
      ;;
    *)
      mkdir "$file.w1" 2>/dev/null || return 0
      human="Context is at ${ctx_k}k tokens. Every message re-sends all of it. Finish this task and start nothing new."
      model="The context is at ${ctx_k}k tokens and every message re-sends all of it. Finish the current task and do not start a new one in this session."
      ;;
  esac
  HUMAN="$human" MODEL="$model" perl -MJSON::PP -e '
    print JSON::PP->new->canonical->encode({
      systemMessage => $ENV{HUMAN},
      hookSpecificOutput => { hookEventName => "UserPromptSubmit", additionalContext => $ENV{MODEL} },
    }), "\n";'
}

# Claude Code hook: UserPromptSubmit saves hand edits made between turns,
# Stop saves what the turn changed, labelled with its prompt. Never fails and
# never blocks a prompt. Prints only a context warning, as hook JSON: anything
# else on stdout reaches the model. With --warn-only it only warns and never
# snapshots, so it is safe at user level and in a folder of photos.
cmd_hook() {
  local parsed event cwd prompt prompt_file warn_only=0
  [ "${1:-}" = --warn-only ] && warn_only=1
  parsed="$(perl -MJSON::PP -e '
    local $/; my $in = <STDIN>;
    my $j = eval { JSON::PP->new->utf8->decode($in) } or exit 0;
    ref $j eq "HASH" or exit 0;
    my $p = $j->{prompt} // "";
    $p =~ s/\s+/ /g; $p =~ s/^ //;
    $p = substr($p, 0, 60);
    binmode STDOUT, ":utf8";
    print join("\n", $j->{hook_event_name} // "", $j->{cwd} // "", $p, $j->{session_id} // ""), "\n";
  ' 2>/dev/null)" || return 0
  event="$(printf '%s\n' "$parsed" | sed -n 1p)"
  cwd="$(printf '%s\n' "$parsed" | sed -n 2p)"
  prompt="$(printf '%s\n' "$parsed" | sed -n 3p)"
  [ "$event" = UserPromptSubmit ] && context_warning "$(printf '%s\n' "$parsed" | sed -n 4p)"
  [ "$warn_only" = 1 ] && return 0
  [ -n "$cwd" ] && cd "$cwd" 2>/dev/null
  in_repo 2>/dev/null || return 0
  prompt_file="$(git_path fdd-prompt)"
  export FDD_QUIET=1
  case "$event" in
    UserPromptSubmit)
      printf '%s\n' "$prompt" >"$prompt_file" 2>/dev/null
      ( cmd_snapshot "changes outside Claude, before: $prompt" ) >/dev/null 2>&1
      ;;
    Stop)
      prompt="$(cat "$prompt_file" 2>/dev/null)"
      ( cmd_snapshot "${prompt:-turn}" ) >/dev/null 2>&1
      ;;
  esac
  return 0
}

# --- setup --------------------------------------------------------------------

# Merges templates/user-settings.json into a settings file, or takes it out.
# Args: add|remove, template, settings file (may be missing), output file.
# Prints one line per key, tab separated: ADD, DEL, KEEP, FOREIGN or EDITED (a
# status line that runs the meter but is not setup's), the key and its command;
# or INVALID and a reason (exit 1). Writes the output only when it prints ADD or
# DEL. Removing drops only the exact command and the exact
# statusLine value setup writes, and the lists and objects that leaves empty.
SETTINGS_MERGE='
use strict; use warnings; use JSON::PP; use Math::BigFloat;
my ($mode, $tpl_path, $path, $out) = @ARGV;
# allow_bignum keeps long decimals and big integers as they are.
my $js = JSON::PP->new->utf8->allow_bignum;
my $cn = JSON::PP->new->utf8->canonical->allow_bignum;
my $pretty = JSON::PP->new->utf8->canonical->allow_bignum->indent->indent_length(2)->space_after;
sub slurp { open my $f, "<:raw", $_[0] or return undef; local $/; my $s = <$f>; close $f; defined $s ? $s : "" }
sub invalid { print "INVALID\t$_[0]\n"; exit 1 }
# The number tokens of a JSON text, strings skipped.
sub numbers {
  my @n;
  while ($_[0] =~ /"[^"\\]*(?:\\.[^"\\]*)*"|(-?(?:0|[1-9][0-9]*)(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)/gs) {
    push @n, $1 if defined $1;
  }
  @n;
}
my $tpl = eval { $js->decode(slurp($tpl_path) // "") };
ref $tpl eq "HASH" or invalid("the template $tpl_path is missing or broken");
my $S = $tpl->{statusLine};
my $entry = $tpl->{hooks}{UserPromptSubmit}[0];
my $H = $entry->{hooks}[0]{command};
my $j = {};
if (-e $path) {
  my $raw = slurp($path);
  defined $raw or invalid("it cannot be read");
  $j = eval { $js->decode($raw) };
  defined $j or invalid("it is not valid JSON");
  ref $j eq "HASH" or invalid("it is not a JSON object");
  # Every number must come back with the same value. The edit adds no number
  # and drops only entries of setup, so checking the file as read is enough.
  my @was = numbers($raw);
  invalid("a number in it is too large to rewrite") if grep { /[eE][+-]?0*[0-9]{4,}$/ } @was;
  my @now = numbers($pretty->encode($j));
  my $norm = sub { join "\n", sort map { Math::BigFloat->new($_)->bsstr } @_ };
  invalid("a number in it would change when rewritten") if $norm->(@was) ne $norm->(@now);
}
invalid("statusLine is not an object") if exists $j->{statusLine} && ref $j->{statusLine} ne "HASH";
invalid("hooks is not an object") if exists $j->{hooks} && ref $j->{hooks} ne "HASH";
my $ups = exists $j->{hooks} ? $j->{hooks}{UserPromptSubmit} : undef;
invalid("hooks.UserPromptSubmit is not a list") if defined $ups && ref $ups ne "ARRAY";
sub cmd_of { my $c = $_[0]{command}; (defined $c && !ref $c) ? $c : "" }
sub is_h { my $h = shift; ref $h eq "HASH" && cmd_of($h) eq $H }
# A status line calls the meter when its command runs fdd statusline, or runs
# a script that does.
sub calls_meter {
  my $cmd = shift;
  my $re = qr/fdd["\x27]?\s+statusline\b/;
  return 1 if $cmd =~ $re;
  for my $w (split /\s+/, $cmd) {
    $w =~ s/^["\x27]+|["\x27]+$//g;
    $w =~ s{^(?:~|\$HOME|\$\{HOME\})(?=/)}{$ENV{HOME}};
    next unless -f $w && -s _ < 1048576;
    my $s = slurp($w) // next;
    return 1 if $s =~ $re;
  }
  return 0;
}
my $changed = 0;
if ($mode eq "add") {
  my $sl = $j->{statusLine};
  my $ok = 1;
  if (!defined $sl) {
    $j->{statusLine} = $S; $changed = 1;
    print "ADD\tstatusLine\t$S->{command}\n";
  } elsif ($cn->encode($sl) eq $cn->encode($S) || calls_meter(cmd_of($sl))) {
    print "KEEP\tstatusLine\t", cmd_of($sl), "\n";
  } else {
    $ok = 0;
    print "FOREIGN\tstatusLine\t", (cmd_of($sl) eq "" ? "(no command)" : cmd_of($sl)), "\n";
  }
  if ($ok) {
    my $there = 0;
    for my $e (@{ $ups || [] }) {
      next unless ref $e eq "HASH" && ref $e->{hooks} eq "ARRAY";
      $there = 1 if grep { is_h($_) } @{ $e->{hooks} };
    }
    if ($there) {
      print "KEEP\thooks.UserPromptSubmit\t$H\n";
    } else {
      push @{ $j->{hooks}{UserPromptSubmit} }, $entry; $changed = 1;
      print "ADD\thooks.UserPromptSubmit\t$H\n";
    }
  }
} else {
  if (defined $j->{statusLine} && $cn->encode($j->{statusLine}) eq $cn->encode($S)) {
    delete $j->{statusLine}; $changed = 1;
    print "DEL\tstatusLine\t$S->{command}\n";
  } elsif (ref $j->{statusLine} eq "HASH" && calls_meter(cmd_of($j->{statusLine}))) {
    print "EDITED\tstatusLine\t", cmd_of($j->{statusLine}), "\n";
  }
  if (ref $ups eq "ARRAY") {
    my (@keep, $gone);
    for my $e (@$ups) {
      if (ref $e eq "HASH" && ref $e->{hooks} eq "ARRAY") {
        my @h = grep { !is_h($_) } @{ $e->{hooks} };
        if (@h < @{ $e->{hooks} }) {
          $gone = 1;
          # An entry with no hook left goes, matcher and all.
          if (@h) { $e->{hooks} = \@h } else { next }
        }
      }
      push @keep, $e;
    }
    if ($gone) {
      $changed = 1;
      print "DEL\thooks.UserPromptSubmit\t$H\n";
      if (@keep) { $j->{hooks}{UserPromptSubmit} = \@keep }
      else { delete $j->{hooks}{UserPromptSubmit}; delete $j->{hooks} unless %{ $j->{hooks} } }
    }
  }
}
if ($changed) {
  open my $f, ">:raw", $out or invalid("cannot write a temporary file");
  print $f $pretty->encode($j);
  close $f or invalid("cannot write a temporary file");
}
exit 0;
'

setup_new=""
setup_tmp=""
# 1 once there is a plan, 2 once the new-sessions line is out: it comes once per run.
setup_said=0

new_sessions_line() {
  [ "$setup_said" = 2 ] && return 0
  setup_said=2
  printf 'Applies to new sessions only; close open Claude Code sessions first.\n'
}
# An argument error plans nothing, so it gets no new-sessions line.
setup_die() {
  printf 'fdd: %s\n' "$*" >&2
  [ "$setup_said" = 1 ] && new_sessions_line
  exit 1
}

# The size, inode and mtime (to the nanosecond where the system keeps it).
file_stamp() {
  perl -MTime::HiRes=stat -e 'my @s = stat($ARGV[0]); print @s ? join(" ", @s[0, 1, 7, 9]) : "none"' "$1"
}

# Shown when the file cannot be merged safely: what to paste by hand.
setup_by_hand() {
  printf 'Nothing changed. To turn the meter on by hand, merge this into %s:\n\n' "$1"
  cat "$2"
  printf '\n'
}

# Also in tools.md, under Setup at user level. Keep both the same.
setup_snippet() {
  cat <<'EOF'
#!/bin/bash
# ~/.claude/fdd-statusline.sh: your status line, then the context meter.
in="$(cat)"
mine="$(printf '%s' "$in" | YOUR-CURRENT-COMMAND)"
meter="$(printf '%s' "$in" | "$HOME/.claude/skills/fdd/bin/fdd" statusline)"
printf '%s  %s\n' "$mine" "$meter"
EOF
}

setup_why() {
  case "$1" in
    statusLine) printf 'shows the context in tokens, yellow from %sk and red from %sk, sooner on a small window, and keeps the count the hook reads' \
      "$((FDD_WARN_TOKENS / 1000))" "$((FDD_STOP_TOKENS / 1000))" ;;
    *) printf 'tells you and Claude once per level; --warn-only never snapshots, so nothing is copied into .git' ;;
  esac
}

# fdd setup --user: turn the context meter on in ~/.claude/settings.json, backup
# first. --remove takes out exactly what it adds.
cmd_setup() {
  local user=0 dry=0 yes=0 remove=0 home dir file tpl plan rc=0 mode=add tab kind key cmd
  local changes=0 foreign="" edited=0 before after backup="" answer
  while [ $# -gt 0 ]; do
    case "$1" in
      --user) user=1 ;;
      --dry-run) dry=1 ;;
      --yes|-y) yes=1 ;;
      --remove) remove=1; mode=remove ;;
      # The installer probes with --help that this fdd has setup.
      -h|--help)
        printf 'usage: fdd setup --user [--dry-run] [--yes] [--remove]\n'
        printf 'Turns the context meter on in ~/.claude/settings.json, backup first.\n'
        return 0 ;;
      *) setup_die "unknown option $1; usage: fdd setup --user [--dry-run] [--yes] [--remove]" ;;
    esac
    shift
  done
  [ "$user" = 1 ] || setup_die "fdd setup needs --user: it edits ~/.claude/settings.json (see tools.md)"
  home="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)"
  tpl="$home/templates/user-settings.json"
  [ -f "$tpl" ] || setup_die "missing $tpl; reinstall the fdd skill"
  dir="$HOME/.claude"
  file="$dir/settings.json"
  if [ -L "$file" ]; then
    printf 'fdd: %s is a symlink; it is not touched.\n' "$file" >&2
    setup_by_hand "the file it points to" "$tpl"
    new_sessions_line
    return 1
  fi
  if [ -e "$file" ] && [ ! -f "$file" ]; then
    printf 'fdd: %s is not a regular file; it is not touched.\n' "$file" >&2
    setup_by_hand "$file" "$tpl"
    new_sessions_line
    return 1
  fi
  before="$(file_stamp "$file")"
  setup_new="$(mktemp "${TMPDIR:-/tmp}/fdd-settings.XXXXXX")" || setup_die "could not make a temporary file"
  trap 'rm -f "$setup_new" ${setup_tmp:+"$setup_tmp"}' EXIT
  plan="$(perl -e "$SETTINGS_MERGE" -- "$mode" "$tpl" "$file" "$setup_new")" || rc=$?
  if [ "$rc" != 0 ]; then
    printf 'fdd: %s: %s.\n' "$file" "$(printf '%s\n' "$plan" | sed -n 's/^INVALID.//p' | head -1)" >&2
    setup_by_hand "$file" "$tpl"
    new_sessions_line
    return 1
  fi
  # A file locked against edits stays locked: the move would replace it anyway.
  # Only a plan that writes is refused; --dry-run says so too.
  if [ -f "$file" ] && [ ! -w "$file" ] && printf '%s\n' "$plan" | grep -qE '^(ADD|DEL)'; then
    printf 'fdd: %s is read-only; it is not touched.\n' "$file" >&2
    setup_by_hand "$file" "$tpl"
    new_sessions_line
    return 1
  fi

  setup_said=1
  tab="$(printf '\t')"
  if [ "$mode" = add ]; then printf 'fdd setup --user: %s\n' "$file"; else printf 'fdd setup --user --remove: %s\n' "$file"; fi
  while IFS="$tab" read -r kind key cmd; do
    case "$kind" in
      ADD) changes=$((changes + 1)); printf '  + %s: %s\n    why: %s\n' "$key" "$cmd" "$(setup_why "$key")" ;;
      DEL) changes=$((changes + 1)); printf '  - %s: %s\n' "$key" "$cmd" ;;
      KEEP) printf '  = %s: %s (already there, kept)\n' "$key" "$cmd" ;;
      EDITED) edited=1
        printf '  = %s: %s (kept)\n' "$key" "$cmd"
        printf '    statusLine still runs fdd statusline, but not as setup writes it; remove it by hand.\n' ;;
      FOREIGN) foreign="$cmd" ;;
    esac
  done <<EOF
$plan
EOF
  if [ -n "$foreign" ]; then
    printf 'Kept your status line: %s\n' "$foreign"
    printf 'Warnings stay off until your status line calls fdd statusline\n'
    case "$foreign" in
      *fdd-statusline.sh*)
        # Saving the snippet over it would lose what is in it now.
        printf 'It already runs ~/.claude/fdd-statusline.sh, which no longer calls the meter.\n'
        printf 'Do not save over it: put the meter lines back by hand, as in this sample,\n'
        printf 'and run fdd setup --user again:\n\n'
        setup_snippet
        ;;
      *)
        printf 'To keep yours and add the meter, save this as ~/.claude/fdd-statusline.sh:\n\n'
        setup_snippet
        printf '\nPut your command in place of YOUR-CURRENT-COMMAND, set the statusLine command\n'
        printf 'to "bash ~/.claude/fdd-statusline.sh", and run fdd setup --user again.\n'
        ;;
    esac
  fi
  if [ "$changes" = 0 ]; then
    if [ "$mode" = remove ] && [ "$edited" = 1 ]; then
      printf 'Nothing removed: the status line above is yours to take out.\n'
    elif [ "$mode" = remove ]; then
      printf 'Nothing to remove: none of the entries fdd setup writes is there.\n'
    elif [ -z "$foreign" ]; then
      printf 'Nothing to change: the meter is already on.\n'
    fi
    new_sessions_line
    return 0
  fi
  if [ "$dry" = 1 ]; then new_sessions_line; return 0; fi
  if [ "$yes" != 1 ]; then
    new_sessions_line
    printf 'Write this to %s? [y/N] ' "$file"
    answer=""
    read -r answer || true
    [ -t 0 ] || printf '\n'
    case "$answer" in
      y|Y|yes|Yes|YES) ;;
      *) printf 'Nothing changed.\n'; new_sessions_line; return 0 ;;
    esac
  fi

  mkdir -p "$dir" || setup_die "could not make $dir; nothing changed"
  if [ -f "$file" ]; then
    mkdir -p "$dir/settings-backup" || setup_die "could not make $dir/settings-backup; nothing changed"
    backup="$(mktemp "$dir/settings-backup/settings.json.XXXXXX")" || setup_die "could not back up $file; nothing changed"
    cp "$file" "$backup" || { rm -f "$backup"; setup_die "could not back up $file; nothing changed"; }
  fi
  setup_tmp="$(mktemp "$dir/settings.json.XXXXXX")" || setup_die "could not write next to $file; nothing changed"
  cat "$setup_new" >"$setup_tmp" || setup_die "could not write next to $file; nothing changed"
  if [ -f "$file" ]; then
    perl -e 'chmod((stat $ARGV[0])[2] & 07777, $ARGV[1])' "$file" "$setup_tmp"
  fi
  # Tests widen the window between the read and the move with this pause.
  [ -n "${FDD_SETUP_TEST_SLEEP:-}" ] && sleep "$FDD_SETUP_TEST_SLEEP"
  after="$(file_stamp "$file")"
  if [ "$after" != "$before" ]; then
    rm -f "$setup_tmp"
    setup_tmp=""
    printf 'fdd: settings changed while merging, run again. %s was not written.\n' "$file" >&2
    [ -n "$backup" ] && printf 'The copy taken before is in %s.\n' "$backup"
    new_sessions_line
    return 1
  fi
  mv -f "$setup_tmp" "$file" || setup_die "could not replace $file; it is unchanged"
  setup_tmp=""
  printf 'Saved %s.\n' "$file"
  [ -n "$backup" ] && printf 'The old file is in %s.\n' "$backup"
  if [ "$mode" = add ]; then
    printf 'To undo: fdd setup --user --remove\n'
  else
    printf 'To turn it on again: fdd setup --user\n'
  fi
  new_sessions_line
}

case "${1:-}" in
  snapshot) shift; cmd_snapshot "$@" ;;
  undo) shift; cmd_undo "$@" ;;
  redo) shift; cmd_redo "$@" ;;
  goto) shift; cmd_goto "$@" ;;
  history) shift; cmd_history "$@" ;;
  commit) shift; cmd_commit "$@" ;;
  statusline) shift; cmd_statusline "$@"; exit 0 ;;
  hook) shift; cmd_hook "$@"; exit 0 ;;
  setup) shift; cmd_setup "$@"; exit $? ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 2 ;;
esac
