---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const articles = (await getCollection('articles', ({ data }) => data.draft !== true)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);
---

<BaseLayout
  title="Articles — Sorrel"
  description="Notes on MCP context cost, Claude Code setup, and piloting your AI dev stack."
>
  <section class="articles">
    <h1>Articles</h1>
    <p class="muted">Measured notes on MCP context cost and piloting Claude Code.</p>

    {
      articles.length === 0 ? (
        <p class="muted">No articles yet — check back soon.</p>
      ) : (
        <div class="articles__grid">
          {articles.map((a) => (
            <ArticleCard
              title={a.data.title}
              description={a.data.description}
              publishDate={a.data.publishDate}
              slug={a.id}
            />
          ))}
        </div>
      )
    }
  </section>

  <style>
    .articles h1 {
      margin-bottom: 0.25rem;
    }
    .articles__grid {
      display: grid;
      gap: 1rem;
      margin-top: 2rem;
    }
  </style>
</BaseLayout>
