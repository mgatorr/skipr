---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const articles = (await getCollection('articles', ({ data }) => data.draft !== true)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);
---

<BaseLayout
  title="Field notes — skipr"
  description="Notes on building real software with AI, owning your code, and going from no-code to shipped."
>
  <section class="articles container article-wrap">
    <span class="plate-num">Plate 03 — field notes</span>
    <h1 class="articles__title">Field notes<span class="ink-orange">.</span></h1>
    <p class="articles__lead">
      Notes on building real software with AI — and owning what you build.
    </p>

    {
      articles.length === 0 ? (
        <p class="muted">No notes yet — check back soon.</p>
      ) : (
        <div class="articles__grid">
          {articles.map((a) => (
            <ArticleCard
              title={a.data.title}
              description={a.data.description}
              publishDate={a.data.publishDate}
              slug={a.id}
            />
          ))}
        </div>
      )
    }
  </section>

  <style>
    .plate-num {
      display: block;
      margin-bottom: 16px;
    }
    .articles__title {
      font-family: var(--disp);
      font-weight: 800;
      font-size: clamp(2.4rem, 6vw, 4rem);
      letter-spacing: -0.04em;
      line-height: 0.95;
      margin: 0 0 0.5rem;
    }
    .articles__lead {
      font-family: var(--read);
      font-size: clamp(1.05rem, 1.6vw, 1.25rem);
      color: var(--ink-2);
      max-width: 52ch;
    }
    .articles__grid {
      display: grid;
      gap: 1.1rem;
      margin-top: 2.5rem;
    }
  </style>
</BaseLayout>
