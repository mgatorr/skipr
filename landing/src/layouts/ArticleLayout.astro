---
import BaseLayout from './BaseLayout.astro';
import { useTranslations, getLocale, localizePath } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  ogImage?: string;
  canonical?: string;
  slug: string;
}
const { title, description, publishDate, ogImage, canonical, slug } = Astro.props;

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const docsHref = localizePath('/docs', locale);
void slug; // reserved for per-article attribution if needed

const siteUrl = Astro.site ?? new URL('http://localhost:4321');
const url = new URL(`/articles/${slug}`, siteUrl).href;
const isoDate = publishDate.toISOString();
const displayDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: isoDate,
  url,
  ...(ogImage ? { image: new URL(ogImage, siteUrl).href } : {}),
  publisher: { '@type': 'Organization', name: 'skipr' },
};
---

<BaseLayout
  title={`${title} — skipr`}
  description={description}
  ogImage={ogImage}
  type="article"
  canonical={canonical}
>
  <div class="container article-wrap">
    <article class="article">
      <a class="back" href="/articles">← all field notes</a>
      <h1 class="article__title">{title}</h1>
      <p class="article__meta">
        <time datetime={isoDate}>{displayDate}</time>
      </p>

      <div class="article__body">
        <slot />
      </div>

      <aside class="article__cta" id="start">
        <span class="plate-num">The whole point</span>
        <h2>{t('article.cta.h')}</h2>
        <p class="cta__lead">{t('article.cta.lead')}</p>
        <a class="btn btn-ink" href={docsHref}>{t('article.cta.btn')}</a>
      </aside>
    </article>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <style>
    .article {
      max-width: 46rem;
    }
    .back {
      display: inline-block;
      margin-bottom: 1.5rem;
      font-family: var(--mono);
      font-size: 12px;
      letter-spacing: 0.04em;
      color: var(--ink-3);
    }
    .back:hover {
      color: var(--orange-ink);
      text-decoration: none;
    }
    .article__title {
      font-size: clamp(1.9rem, 5vw, 2.9rem);
      line-height: 1.05;
      margin: 0 0 0.6rem;
    }
    .article__meta {
      margin: 0 0 2.2rem;
      font-family: var(--mono);
      font-size: 12px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink-3);
    }
    .article__body {
      line-height: 1.75;
    }
    .article__body :global(h2) {
      font-family: var(--disp);
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-top: 2.4rem;
    }
    .article__body :global(pre) {
      background: var(--paper-3);
      border: 2px solid var(--rule);
      padding: 1rem;
      overflow-x: auto;
      font-family: var(--mono);
    }
    .article__body :global(code) {
      font-family: var(--mono);
      font-size: 0.92em;
    }
    .article__cta {
      margin-top: 3.5rem;
      padding: 1.75rem;
      border: 2px solid var(--ink);
      background: var(--paper-2);
      box-shadow: 6px 6px 0 var(--orange);
    }
    .article__cta .plate-num {
      display: block;
      margin-bottom: 0.6rem;
    }
    .article__cta h2 {
      font-family: var(--disp);
      font-weight: 800;
      letter-spacing: -0.03em;
      margin: 0 0 0.5rem;
    }
    .cta__lead {
      font-family: var(--read);
      color: var(--ink-2);
      margin: 0 0 1.2rem;
    }
  </style>
</BaseLayout>
