---
import '../styles/theme.css';
import { useTranslations, getLocale, localizePath, basePath, otherLocale } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  /** Path under /og/ for the social card; falls back to the default card. */
  ogImage?: string;
  /** Open Graph type; "website" for pages, "article" for posts. */
  type?: 'website' | 'article';
  /** Optional canonical override (e.g. syndicated article). */
  canonical?: string;
}

const {
  title,
  description,
  ogImage = '/og/default.png',
  type = 'website',
  canonical,
} = Astro.props;

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const siteUrl = Astro.site ?? new URL('http://localhost:4321');
const canonicalURL = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const ogImageURL = new URL(ogImage, siteUrl).href;
const year = new Date().getFullYear();

// Locale alternates. The landing home exists in both locales; the language
// switch always points to the other locale's home (no 404), and hreflang
// alternates are emitted only where an equivalent page exists (the home).
const base = basePath(Astro.url.pathname);
const isHome = base === '/';
const enHref = new URL('/', siteUrl).href;
const esHref = new URL('/es/', siteUrl).href;
const switchHref = localizePath('/', otherLocale(locale));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {
      isHome && (
        <>
          <link rel="alternate" hreflang="en" href={enHref} />
          <link rel="alternate" hreflang="es" href={esHref} />
          <link rel="alternate" hreflang="x-default" href={enHref} />
        </>
      )
    }

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="skipr" />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="container site-header">
      <a href={localizePath('/', locale)} class="brand">skipr<span class="accent">_</span></a>
      <nav>
        <a href={localizePath('/articles', locale)}>{t('nav.articles')}</a>
        <a href={switchHref} class="locale" rel="alternate" hreflang={otherLocale(locale)}>
          {t('locale.switch')}
        </a>
      </nav>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="container site-footer">
      <p class="muted">
        {t('disclaimer')} &ldquo;Claude&rdquo; and &ldquo;Claude Code&rdquo; are trademarks of their respective
        owner.
      </p>
      <p class="muted">© {year} skipr · {t('footer.tagline')}</p>
    </footer>

    <style>
      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block: 1.25rem;
      }
      .brand {
        font-weight: 700;
        font-size: 1.15rem;
        color: var(--fg);
      }
      .brand:hover {
        text-decoration: none;
      }
      nav {
        display: flex;
        gap: 1.1rem;
        align-items: center;
      }
      .locale {
        color: var(--fg-muted);
        font-size: 0.9rem;
      }
      .site-footer {
        margin-top: 4rem;
        padding-block: 2rem;
        border-top: 1px solid var(--border);
        font-size: 0.85rem;
      }
      .site-footer p {
        margin: 0.3rem 0;
      }
    </style>
  </body>
</html>
