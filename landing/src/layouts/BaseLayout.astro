---
import '../styles/theme.css';

interface Props {
  title: string;
  description: string;
  /** Path under /og/ for the social card; falls back to the default card. */
  ogImage?: string;
  /** Open Graph type; "website" for pages, "article" for posts. */
  type?: 'website' | 'article';
  /** Optional canonical override (e.g. syndicated article). */
  canonical?: string;
}

const {
  title,
  description,
  ogImage = '/og/default.png',
  type = 'website',
  canonical,
} = Astro.props;

const siteUrl = Astro.site ?? new URL('http://localhost:4321');
const canonicalURL = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const ogImageURL = new URL(ogImage, siteUrl).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Sorrel" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="container site-header">
      <a href="/" class="brand">sorrel<span class="accent">_</span></a>
      <nav>
        <a href="/articles">articles</a>
      </nav>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="container site-footer">
      <p class="muted">
        Sorrel is an independent project and is <strong>not affiliated with Anthropic</strong>.
        &ldquo;Claude&rdquo; and &ldquo;Claude Code&rdquo; are trademarks of their respective owner.
      </p>
      <p class="muted">© {year} Sorrel · built for people who pilot Claude Code</p>
    </footer>

    <style>
      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block: 1.25rem;
      }
      .brand {
        font-weight: 700;
        font-size: 1.15rem;
        color: var(--fg);
      }
      .brand:hover {
        text-decoration: none;
      }
      .site-footer {
        margin-top: 4rem;
        padding-block: 2rem;
        border-top: 1px solid var(--border);
        font-size: 0.85rem;
      }
      .site-footer p {
        margin: 0.3rem 0;
      }
    </style>
  </body>
</html>
