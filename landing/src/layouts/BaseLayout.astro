---
// Self-hosted fonts (bundled, no render-blocking external request → Lighthouse).
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
// Preload the latin subsets that drive the LCP (display h1) and body text, so
// the web fonts are ready before first paint — kills the font-swap CLS.
import bricolageWoff2 from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import newsreaderWoff2 from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import '../styles/theme.css';
import SiteFooter from '../components/SiteFooter.astro';
import { useTranslations, getLocale, localizePath, basePath } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  /** Path under /og/ for the social card; falls back to the default card. */
  ogImage?: string;
  /** Open Graph type; "website" for pages, "article" for posts. */
  type?: 'website' | 'article';
  /** Optional canonical override (e.g. syndicated article). */
  canonical?: string;
  /** Render the rich landing footer (foot-word + optional updates form). */
  footerCta?: boolean;
}

const {
  title,
  description,
  ogImage = '/og/default.png',
  type = 'website',
  canonical,
  footerCta = false,
} = Astro.props;

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const siteUrl = Astro.site ?? new URL('http://localhost:4321');
const canonicalURL = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const ogImageURL = new URL(ogImage, siteUrl).href;

// Locale alternates. The landing home exists in both locales; hreflang
// alternates are emitted only on the home (the only fully-translated page).
const base = basePath(Astro.url.pathname);
const isHome = base === '/';
const enHref = new URL('/', siteUrl).href;
const esHref = new URL('/es/', siteUrl).href;

const homeHref = localizePath('/', locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {
      isHome && (
        <>
          <link rel="alternate" hreflang="en" href={enHref} />
          <link rel="alternate" hreflang="es" href={esHref} />
          <link rel="alternate" hreflang="x-default" href={enHref} />
        </>
      )
    }

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="skipr" />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preload" href={bricolageWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={newsreaderWoff2} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a href="#main" class="skip-link">{t('a11y.skip')}</a>

    <!-- ===== DECKLINE ===== -->
    <div class="deckline">
      <div class="wrap">
        <span class="deck-left">{t('deck.left')}</span>
        <span class="langtog" role="group" aria-label="Language">
          <a href="/" hreflang="en" aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
          <span>/</span>
          <a href="/es/" hreflang="es" aria-current={locale === 'es' ? 'true' : undefined}>ES</a>
        </span>
      </div>
    </div>

    <!-- ===== NAV ===== -->
    <nav class="nav">
      <div class="wrap">
        <a class="brand" href={homeHref} aria-label="skipr">skipr<span class="pin">.</span></a>
        <div class="nav-links">
          <a href={`${homeHref}#anti`}><span class="n">01</span><span>{t('nav.anti')}</span></a>
          <a href={`${homeHref}#how`}><span class="n">02</span><span>{t('nav.how')}</span></a>
          <a href={localizePath('/docs', locale)}><span class="n">03</span><span>{t('nav.docs')}</span></a>
        </div>
        <a class="nav-cta" href={localizePath('/docs', locale)}>{t('nav.cta')}</a>
      </div>
    </nav>

    <main id="main">
      <slot />
    </main>

    <SiteFooter cta={footerCta} />
  </body>
</html>
