---
import BaseLayout from './BaseLayout.astro';
import DocsGate from '../components/DocsGate.astro';
import { useTranslations, getLocale, localizePath } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  plate?: string;
}

const { title, description, plate } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const docsHref = localizePath('/docs', locale);
const homeHref = localizePath('/', locale);
---

<BaseLayout title={title} description={description}>
  <div class="container article-wrap docs-wrap">
    <nav class="docs-nav" aria-label="Docs">
      <a class="back" href={homeHref}>← skipr</a>
      <span class="docs-nav-links">
        <a href={docsHref}>{t('docs.nav.start')}</a>
        <a href={localizePath('/docs/harness', locale)}>{t('docs.nav.harness')}</a>
        <a href={localizePath('/docs/levels', locale)}>{t('docs.nav.levels')}</a>
      </span>
    </nav>

    <DocsGate>
      {
        plate && (
          <span class="plate-num">{plate}</span>
        )
      }
      <slot />
    </DocsGate>
  </div>

  <style>
    .docs-wrap {
      max-width: 46rem;
      padding-bottom: 4rem;
    }
    .docs-nav {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem 1.25rem;
      margin-bottom: 1.75rem;
    }
    .back {
      font-family: var(--mono);
      font-size: 12px;
      letter-spacing: 0.04em;
      color: var(--ink-3);
    }
    .back:hover {
      color: var(--orange-ink);
    }
    .docs-nav-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem 1.1rem;
      font-family: var(--mono);
      font-size: 12px;
      letter-spacing: 0.04em;
    }
    .docs-nav-links a {
      color: var(--ink-2);
      border-bottom: 1px solid transparent;
    }
    .docs-nav-links a:hover {
      color: var(--orange-ink);
      border-bottom-color: var(--orange);
    }
    .plate-num {
      display: block;
      margin-bottom: 12px;
    }
    .docs-wrap :global(h1) {
      font-family: var(--disp);
      font-weight: 800;
      font-size: clamp(1.9rem, 5vw, 2.9rem);
      letter-spacing: -0.03em;
      line-height: 1.05;
      margin: 0 0 0.75rem;
    }
    .docs-wrap :global(.lead) {
      font-family: var(--read);
      font-size: clamp(1.05rem, 1.6vw, 1.25rem);
      color: var(--ink-2);
      margin: 0 0 2rem;
      max-width: 52ch;
    }
    .docs-wrap :global(h2) {
      font-family: var(--disp);
      font-weight: 700;
      letter-spacing: -0.02em;
      font-size: clamp(1.35rem, 3vw, 1.7rem);
      margin: 2.4rem 0 0.75rem;
      scroll-margin-top: 92px;
    }
    .docs-wrap :global(h3) {
      font-family: var(--disp);
      font-weight: 700;
      font-size: 1.15rem;
      margin: 1.6rem 0 0.5rem;
      scroll-margin-top: 92px;
    }
    .docs-wrap :global(p),
    .docs-wrap :global(li) {
      line-height: 1.7;
      color: var(--ink);
    }
    .docs-wrap :global(p) {
      margin: 0 0 1rem;
    }
    .docs-wrap :global(ol),
    .docs-wrap :global(ul) {
      margin: 0 0 1.25rem;
      padding-left: 1.35rem;
    }
    .docs-wrap :global(li) {
      margin-bottom: 0.45rem;
    }
    .docs-wrap :global(a:not(.back):not(.btn)) {
      color: var(--orange-ink);
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .docs-wrap :global(pre),
    .docs-wrap :global(.cmd) {
      background: var(--paper-3);
      border: 2px solid var(--rule);
      padding: 0.85rem 1rem;
      overflow-x: auto;
      font-family: var(--mono);
      font-size: 0.88rem;
      line-height: 1.5;
      margin: 0 0 1.25rem;
      border-radius: 4px;
    }
    .docs-wrap :global(code) {
      font-family: var(--mono);
      font-size: 0.92em;
    }
    .docs-wrap :global(p code),
    .docs-wrap :global(li code) {
      background: var(--paper-3);
      padding: 0.1em 0.35em;
      border-radius: 3px;
    }
    .docs-wrap :global(.steps) {
      list-style: none;
      padding: 0;
      counter-reset: step;
    }
    .docs-wrap :global(.steps > li) {
      counter-increment: step;
      position: relative;
      padding: 1.1rem 1.1rem 1.1rem 3.4rem;
      margin-bottom: 0.85rem;
      border: 2px solid var(--rule);
      background: var(--paper-2);
      border-radius: 4px;
    }
    .docs-wrap :global(.steps > li::before) {
      content: counter(step, decimal-leading-zero);
      position: absolute;
      left: 0.85rem;
      top: 1.15rem;
      font-family: var(--mono);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.06em;
      color: var(--orange-ink);
    }
    .docs-wrap :global(.steps h3) {
      margin: 0 0 0.4rem;
      font-size: 1.05rem;
    }
    .docs-wrap :global(.steps p:last-child) {
      margin-bottom: 0;
    }
    .docs-wrap :global(.callout) {
      border: 2px solid var(--ink);
      background: var(--paper-2);
      box-shadow: 5px 5px 0 var(--blue);
      padding: 1.25rem 1.4rem;
      margin: 1.75rem 0;
    }
    .docs-wrap :global(.callout.grow) {
      box-shadow: 5px 5px 0 var(--orange);
    }
    .docs-wrap :global(.callout h2) {
      margin-top: 0;
    }
    .docs-wrap :global(.docs-cta) {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
      margin: 1.5rem 0 0.5rem;
    }
    .docs-wrap :global(.btn) {
      text-decoration: none;
    }
    .docs-wrap :global(.muted) {
      color: var(--ink-3);
      font-size: 0.95em;
    }
    .docs-wrap :global(.toc) {
      display: grid;
      gap: 0.55rem;
      margin: 0 0 2rem;
      padding: 1rem 1.15rem;
      border: 2px solid var(--rule);
      background: var(--paper-2);
      font-family: var(--mono);
      font-size: 13px;
    }
    .docs-wrap :global(.toc a) {
      text-decoration: none;
      color: var(--ink-2);
    }
    .docs-wrap :global(.toc a:hover) {
      color: var(--orange-ink);
    }
  </style>
</BaseLayout>
