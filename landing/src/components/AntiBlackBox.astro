---
import { useTranslations, getLocale } from '../i18n/ui';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const aList = [t('a.l1'), t('a.l2'), t('a.l3'), t('a.l4'), t('a.l5')];
const bList = [t('b.l1'), t('b.l2'), t('b.l3'), t('b.l4'), t('b.l5')];
---

<section class="sec" id="anti">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="plate-num">{t('anti.num')}</span>
      <h2 class="sec-title" set:html={t('anti.title')} />
      <p class="sec-lead">{t('anti.lead')}</p>
    </div>

    <div class="exhibits">
      <!-- EXHIBIT A -->
      <article class="exhibit a reveal d1">
        <div class="ex-head">
          <span class="ex-id">{t('a.id')}</span>
          <span class="ex-id"><span class="tag">{t('a.tag')}</span></span>
        </div>
        <h3>{t('a.h')}</h3>
        <p class="ex-sub">{t('a.sub')}</p>
        <ul class="exlist">
          {
            aList.map((item) => (
              <li>
                <>
                  <span class="m">✕</span>
                  <span>{item}</span>
                </>
              </li>
            ))
          }
        </ul>
        <div class="bigcrate" aria-hidden="true">
          <span class="plank x1"></span><span class="plank x2"></span>
          <span class="lockbig"><b></b><i></i></span>
          <span class="seal">{t('a.seal')}</span>
        </div>
      </article>

      <!-- DIVIDER -->
      <div class="ex-divider reveal d2" aria-hidden="true">
        <svg class="arrow-hand" viewBox="0 0 74 54">
          <path d="M4 38 C 20 10, 40 8, 64 20 M64 20 L54 16 M64 20 L58 30"></path>
        </svg>
        <span class="lbl marker-note">{t('div.lbl')}</span>
      </div>

      <!-- EXHIBIT B -->
      <article class="exhibit b reveal d2">
        <div class="ex-head">
          <span class="ex-id">{t('b.id')}</span>
          <span class="ex-id"><span class="tag">{t('b.tag')}</span></span>
        </div>
        <h3 set:html={t('b.h')} />
        <p class="ex-sub">{t('b.sub')}</p>
        <ul class="exlist">
          {
            bList.map((item) => (
              <li>
                <>
                  <span class="m">✓</span>
                  <span>{item}</span>
                </>
              </li>
            ))
          }
        </ul>
        <div class="repo" aria-hidden="true">
          <div class="rtab">
            <span class="br">{t('b.branch')}</span>
            <span class="ow"><span>{t('b.owner')}</span><b>{t('b.ownerb')}</b></span>
          </div>
          <div class="rtree">
            <div class="r"><span class="d">▸</span><span class="d">{t('b.t1')}</span></div>
            <div class="r"><span class="k">··</span><span>{t('b.t2')}</span></div>
            <div class="r"><span class="d">▸</span><span class="d">{t('b.t3')}</span></div>
            <div class="r"><span class="d">▸</span><span class="d">{t('b.t4')}</span></div>
            <div class="r"><span class="k">··</span><span>{t('b.t5')}</span></div>
          </div>
          <span class="keybadge">{t('b.key')}</span>
        </div>
      </article>
    </div>

    <!-- creed -->
    <div class="creed reveal">
      <span class="creed-mk">{t('creed.mk')}</span>
      <q set:html={t('creed')} />
    </div>
  </div>
</section>
