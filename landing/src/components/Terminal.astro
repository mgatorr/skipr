---
interface Props {
  title?: string;
}
const { title = 'skipr — guided' } = Astro.props;
---

<div class="terminal" role="img" aria-label="skipr's guided build-and-deploy flow">
  <div class="terminal__bar">
    <span class="terminal__dot"></span>
    <span class="terminal__dot"></span>
    <span class="terminal__dot"></span>
    <span class="terminal__title">{title}</span>
  </div>
  <div class="terminal__body">
    <slot />
  </div>
</div>

<style>
  .terminal__title {
    margin-left: 0.4rem;
  }
</style>
