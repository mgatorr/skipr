---
import WaitlistForm from './WaitlistForm.astro';
import { useTranslations, getLocale, localizePath } from '../i18n/ui';

interface Props {
  /** Render the foot-word + optional updates form (landing only). */
  cta?: boolean;
}
const { cta = false } = Astro.props;

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const articlesHref = localizePath('/articles', locale);
const docsHref = localizePath('/docs', locale);
---

<footer class="foot">
  <div class="wrap">
    {
      cta && (
        <div class="foot-top">
          <div class="foot-word reveal">
            skipr<span class="pin">.</span>
          </div>
          <div class="foot-right reveal d1" id="avisos">
            <p set:html={t('foot.cta')} />
            <p class="foot-avisos muted">{t('foot.avisos')}</p>
            <div class="foot-cta-row">
              <a class="btn btn-ink" href={docsHref}>{t('hero.btn')}</a>
            </div>
            <WaitlistForm
              source="landing-footer"
              formId="waitlist"
              buttonLabel={t('foot.btn')}
              withStates={true}
            />
          </div>
        </div>
      )
    }
    <div class="colophon">
      <p class="disclaimer">{t('foot.disc')}</p>
      <div class="foot-meta">
        <a href={docsHref}>{t('docs.nav.start')}</a>
        <a href={articlesHref}>{t('foot.notes')}</a>
        <span>{t('foot.coming')}</span>
        <span>{t('foot.copy')}</span>
      </div>
    </div>
  </div>
</footer>
