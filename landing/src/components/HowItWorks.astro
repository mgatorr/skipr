---
import { useTranslations, getLocale } from '../i18n/ui';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const plates = [
  { n: '01', h: t('m1.h'), p: t('m1.p'), tool: t('m1.tool'), when: t('m1.when') },
  { n: '02', h: t('m2.h'), p: t('m2.p'), tool: t('m2.tool'), when: t('m2.when') },
  { n: '03', h: t('m3.h'), p: t('m3.p'), tool: t('m3.tool'), when: t('m3.when') },
  { n: '04', h: t('m4.h'), p: t('m4.p'), tool: t('m4.tool'), when: t('m4.when') },
  { n: '05', h: t('m5.h'), p: t('m5.p'), tool: t('m5.tool'), when: t('m5.when') },
];

const rows = [
  { cat: t('stack.c1'), def: 'GitHub' },
  { cat: t('stack.c2'), def: 'Vercel' },
  { cat: t('stack.c3'), def: 'Supabase' },
];
---

<section class="sec" id="how">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="plate-num">{t('how.num')}</span>
      <h2 class="sec-title" set:html={t('how.title')} />
      <p class="sec-lead">{t('how.lead')}</p>
    </div>

    <div class="manual">
      {
        plates.map((plate) => (
          <div class="plate reveal">
            <div class="pn">{plate.n}</div>
            <div class="pbody">
              <h3>{plate.h}</h3>
              <p>{plate.p}</p>
            </div>
            <div class="ptool">
              <span class="toolchip">{plate.tool}</span>
              <span class="when">{plate.when}</span>
            </div>
          </div>
        ))
      }
    </div>

    <p class="manual-foot reveal">
      <span>{t('how.foot')}</span>
      <b>Claude Code</b><span class="pipe">·</span><b>GitHub</b><span class="pipe">·</span><b
        >Supabase</b
      ><span class="pipe">·</span><b>Vercel</b>
    </p>

    <!-- your stack, your call -->
    <div class="stackcard reveal">
      <div class="sc-top">
        <h3 set:html={t('stack.h')} />
        <span class="sc-tag">{t('stack.tag')}</span>
      </div>
      <p class="sc-lead">{t('stack.lead')}</p>
      <div class="stackrows">
        {
          rows.map((row) => (
            <div class="stackrow">
              <div class="cat">{row.cat}</div>
              <div class="def">{row.def}</div>
              <div class="alt">
                <span>{t('stack.or')}</span> <b>{t('stack.soon')}</b>
              </div>
            </div>
          ))
        }
      </div>
      <p class="sc-foot" set:html={t('stack.foot')} />
    </div>
  </div>
</section>
