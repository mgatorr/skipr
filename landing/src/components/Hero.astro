---
import { useTranslations, getLocale, localizePath } from '../i18n/ui';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const docsHref = localizePath('/docs', locale);
const harnessHref = localizePath('/docs/harness', locale);
---

<header class="hero" id="top">
  <div class="wrap hero-grid">
    <div class="hero-left">
      <div class="hero-kick">
        <span class="stamp blue"><span class="dotpulse"></span><span>{t('hero.stamp')}</span></span>
        <span class="vol">{t('hero.vol')}</span>
      </div>

      <h1 class="head ghost" set:html={t('hero.h1')} />

      <p class="dek" set:html={t('hero.dek')} />

      <p class="hero-note marker-note">{t('hero.note')}</p>

      <div class="hero-cta">
        <a class="btn btn-ink" href={docsHref}>{t('hero.btn')}</a>
        <a class="hero-secondary" href={harnessHref}>{t('hero.secondary')} →</a>
      </div>

      <p class="hero-foot">{t('hero.foot')}</p>
    </div>

    <!-- specimen: the hand-off -->
    <aside class="specimen" aria-hidden="true">
      <span class="spec-cap">{t('spec.cap')}</span>
      <div class="handoff">
        <div class="crate">
          <div class="pad"><b></b><i></i></div>
          <div class="clab">{t('spec.crate')}</div>
        </div>
        <div class="mid">
          <svg class="keyico" viewBox="0 0 54 24" aria-hidden="true">
            <path d="M14 12 a7 7 0 1 0 0.01 0 M21 12 H50 M44 12 V18 M50 12 V19"></path>
          </svg>
          <small>{t('spec.key')}</small>
        </div>
        <div class="folder">
          <span class="ftab"></span>
          <span class="frow"></span><span class="frow"></span><span class="frow"></span>
          <span class="own">{t('spec.folder')}</span>
        </div>
      </div>
      <span class="spec-tag">{t('spec.tag')}</span>
    </aside>
  </div>
</header>
