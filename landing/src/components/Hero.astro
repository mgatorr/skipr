---
import WaitlistForm from './WaitlistForm.astro';
import Terminal from './Terminal.astro';
import { useTranslations, getLocale } from '../i18n/ui';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<section class="hero">
  <p class="badge">{t('hero.badge')}</p>
  <h1 class="hero__title">
    {t('hero.titleLead')}
    <span class="accent">{t('hero.titleAccent')}</span>
  </h1>
  <p class="hero__lede">{t('hero.lede')}</p>

  <div class="hero__cta" id="waitlist">
    <WaitlistForm source="landing" />
  </div>

  <div class="hero__demo">
    <Terminal title="skipr — guided">
      <pre
        class="demo"><span class="muted">$ skipr new my-app</span>
<span class="accent">✓</span> Claude Code ready  <span class="muted">— no terminal needed</span>
<span class="accent">✓</span> spec written from your idea
<span class="accent">✓</span> building…  <span class="muted">your files, on your machine</span>
<span class="accent">✓</span> pushed to <span class="muted">your</span> GitHub repo
<span class="accent">✓</span> deployed to Vercel + Supabase
<span class="muted">────────────────────────────────────</span>
your app is live — <span class="accent">and it&rsquo;s yours.</span></pre>
    </Terminal>
  </div>
</section>

<style>
  .hero {
    padding-block: 1rem 2rem;
  }
  .badge {
    display: inline-block;
    color: var(--accent);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
    font-size: 0.8rem;
    margin: 0 0 1rem;
  }
  .hero__title {
    font-size: clamp(1.9rem, 6vw, 3.2rem);
    line-height: 1.1;
    margin: 0 0 1rem;
    letter-spacing: -0.01em;
  }
  .hero__lede {
    font-size: clamp(1rem, 2.4vw, 1.2rem);
    color: var(--fg-muted);
    max-width: 44rem;
    margin: 0 0 1.75rem;
  }
  .hero__cta {
    max-width: 40rem;
    margin-bottom: 2.5rem;
  }
  .hero__demo {
    display: grid;
    gap: 0.75rem;
  }
  .demo {
    margin: 0;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.6;
    white-space: pre;
  }
</style>
