---
import WaitlistForm from './WaitlistForm.astro';
import Terminal from './Terminal.astro';
import Disclaimer from './Disclaimer.astro';
---

<section class="hero">
  <p class="badge">▲ coming soon</p>
  <h1 class="hero__title">
    See what your MCP servers <span class="accent">really cost</span>.
  </h1>
  <p class="hero__lede">
    Sorrel is a friendly control layer for piloting Claude Code. Its hero feature measures how much
    of your context window <strong>each MCP server</strong> eats — so you can stop paying for tool schemas
    you never use.
  </p>

  <div class="hero__cta" id="waitlist">
    <WaitlistForm source="landing" />
  </div>

  <div class="hero__demo">
    <Terminal>
      <pre
        class="demo"><span class="muted">$ sorrel analyze</span>
server            tools   <span class="muted">context cost</span>
github             42     <span class="accent">8,310 tok</span>
playwright         31     <span class="accent">6,740 tok</span>
supabase           28     <span class="accent">5,120 tok</span>
filesystem          9     <span class="accent">1,180 tok</span>
<span class="muted">────────────────────────────────────</span>
total                     <span class="accent">21,350 tok</span>  <span class="muted">(~34% of context)</span>
<span class="muted"># est. — measured from each server's tools/list schema</span></pre>
    </Terminal>
    <Disclaimer />
  </div>
</section>

<style>
  .hero {
    padding-block: 1rem 2rem;
  }
  .badge {
    display: inline-block;
    color: var(--accent);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
    font-size: 0.8rem;
    margin: 0 0 1rem;
  }
  .hero__title {
    font-size: clamp(1.9rem, 6vw, 3.2rem);
    line-height: 1.1;
    margin: 0 0 1rem;
    letter-spacing: -0.01em;
  }
  .hero__lede {
    font-size: clamp(1rem, 2.4vw, 1.2rem);
    color: var(--fg-muted);
    max-width: 42rem;
    margin: 0 0 1.75rem;
  }
  .hero__cta {
    max-width: 40rem;
    margin-bottom: 2.5rem;
  }
  .hero__demo {
    display: grid;
    gap: 0.75rem;
  }
  .demo {
    margin: 0;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.5;
    white-space: pre;
  }
</style>
