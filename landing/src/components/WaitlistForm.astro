---
import { useTranslations, getLocale } from '../i18n/ui';

interface Props {
  /** Attribution tag stored with the lead (e.g. "landing", "article:<slug>"). */
  source?: string;
  /** DOM id / anchor target for this form (the nav CTA points at #waitlist). */
  formId?: string;
  /** Submit button label. Defaults to the hero CTA copy. */
  buttonLabel?: string;
  /**
   * Render the shared no-JS state block (#wl-success / #wl-invalid / #wl-error).
   * Exactly ONE form per page should set this true — the API redirects to a
   * single `/#wl-<outcome>` hash, so the targets must be unique on the page.
   */
  withStates?: boolean;
}
const { source = 'landing', formId = 'waitlist', buttonLabel, withStates = false } = Astro.props;

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const label = buttonLabel ?? t('hero.btn');
const emailId = `email-${formId}`;
---

<form
  id={formId}
  class="waitlist"
  method="POST"
  action="/api/waitlist"
  novalidate
  data-ok={t('wl.ok')}
  data-invalid={t('wl.invalid')}
  data-error={t('wl.error')}
>
  <input type="hidden" name="source" value={source} />

  <!-- Honeypot: hidden from humans; bots that fill it are silently dropped. -->
  <div class="hp" aria-hidden="true">
    <label>Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="field">
    <label for={emailId}>{t('hero.email.l')}</label>
    <input
      id={emailId}
      type="email"
      name="email"
      placeholder={t('hero.email')}
      autocomplete="email"
      aria-label={t('hero.email.l')}
      required
    />
  </div>
  <button class="btn btn-ink" type="submit">{label}</button>

  <!-- JS-enhanced inline status (filled by the script; no navigation). -->
  <p class="status js-status" role="status" aria-live="polite"></p>

  {
    withStates && (
      <>
        {/* No-JS states: revealed via CSS :target after the endpoint's 303 redirect. */}
        <p id="wl-success" class="status status--ok wl-state" role="status">
          {t('wl.ok')}
        </p>
        <p id="wl-invalid" class="status status--err wl-state" role="status">
          {t('wl.invalid')}
        </p>
        <p id="wl-error" class="status status--err wl-state" role="status">
          {t('wl.error')}
        </p>
      </>
    )
  }
</form>

<script>
  // Progressive enhancement: without this script the native POST still works
  // (the endpoint 303-redirects to /#wl-...). With it, each waitlist form on the
  // page submits via fetch and renders an inline state without navigation.
  // Localized messages come from each form's data-* attributes.
  const forms = document.querySelectorAll<HTMLFormElement>('form.waitlist');

  forms.forEach((form) => {
    const status = form.querySelector<HTMLParagraphElement>('.js-status');
    const msg = {
      ok: form.dataset.ok ?? '',
      invalid: form.dataset.invalid ?? '',
      error: form.dataset.error ?? '',
    };

    function setStatus(ok: boolean, message: string) {
      if (!status) return;
      status.textContent = message;
      status.classList.remove('status--ok', 'status--err');
      status.classList.add(ok ? 'status--ok' : 'status--err');
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const email = String(data.get('email') ?? '').trim();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setStatus(false, msg.invalid);
        return;
      }
      try {
        const res = await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(data.entries())),
        });
        const body = await res.json().catch(() => ({ ok: res.ok, status: 'error' }));
        if (body.ok) {
          setStatus(true, msg.ok);
          form.reset();
        } else if (body.status === 'invalid') {
          setStatus(false, msg.invalid);
        } else {
          setStatus(false, msg.error);
        }
      } catch {
        setStatus(false, msg.error);
      }
    });
  });
</script>
