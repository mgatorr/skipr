---
interface Props {
  title: string;
  description: string;
  publishDate: Date;
  slug: string;
}
const { title, description, publishDate, slug } = Astro.props;
const isoDate = publishDate.toISOString();
const displayDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a class="card" href={`/articles/${slug}`}>
  <time class="card__date" datetime={isoDate}>{displayDate}</time>
  <h2 class="card__title">{title}</h2>
  <p class="card__desc">{description}</p>
  <span class="card__more">read →</span>
</a>

<style>
  .card {
    display: block;
    padding: 24px;
    border: 2px solid var(--ink);
    background: var(--paper-2);
    color: var(--ink);
    transition:
      transform 0.16s var(--ease),
      box-shadow 0.2s var(--ease);
  }
  .card:hover {
    text-decoration: none;
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--orange);
  }
  .card__date {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .card__title {
    font-family: var(--disp);
    font-weight: 700;
    font-size: 1.4rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0.4rem 0 0.55rem;
  }
  .card__desc {
    font-family: var(--read);
    color: var(--ink-2);
    margin: 0 0 1rem;
  }
  .card__more {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--orange-ink);
  }
</style>
