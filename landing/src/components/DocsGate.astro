---
import WaitlistForm from './WaitlistForm.astro';
import { useTranslations, getLocale } from '../i18n/ui';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const formId = `docs-gate-${locale}`;
---

<aside class="docs-gate" id="docs-gate" aria-labelledby="docs-gate-title">
  <span class="plate-num">{t('gate.plate')}</span>
  <h1 id="docs-gate-title">{t('gate.title')}</h1>
  <p class="lead" set:html={t('gate.lead')} />
  <WaitlistForm
    source="docs-gate"
    formId={formId}
    buttonLabel={t('gate.btn')}
  />
  <p class="muted gate-note">{t('gate.note')}</p>
</aside>

<div class="docs-body" data-docs-body>
  <slot />
</div>

<style>
  .docs-gate {
    display: block;
    margin: 0 0 2rem;
    padding: 1.35rem 1.4rem 1.5rem;
    border: 2px solid var(--ink);
    background: var(--paper-2);
    box-shadow: 5px 5px 0 var(--orange);
  }
  .docs-gate :global(h1) {
    font-family: var(--disp);
    font-weight: 800;
    font-size: clamp(1.6rem, 4.2vw, 2.2rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0 0 0.65rem;
  }
  .docs-gate :global(.lead) {
    font-family: var(--read);
    font-size: clamp(1.02rem, 1.5vw, 1.15rem);
    color: var(--ink-2);
    margin: 0 0 1.15rem;
    max-width: 48ch;
  }
  .gate-note {
    margin: 0.85rem 0 0;
    font-size: 0.92em;
    color: var(--ink-3);
  }
  .docs-body {
    display: none;
  }
  :global(html.guide-unlocked) .docs-gate {
    display: none;
  }
  :global(html.guide-unlocked) .docs-body {
    display: block;
  }
</style>

<script>
  import { applyGuideUnlockFromStorage } from '../lib/guideUnlock';
  applyGuideUnlockFromStorage();
</script>
