# Copy to .env for local dev. NEVER commit real values (set them as Vercel env vars in prod).
# The waitlist stores leads in our own Supabase table via an INSERT-only RLS policy.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi_your_anon_key

# Public site URL (used for canonical/OG/sitemap). Safe to expose.
PUBLIC_SITE_URL=http://localhost:4321

# When "1", the waitlist endpoint skips the real Supabase insert and returns success.
# Used by e2e tests and local dev without credentials. Leave unset in production.
WAITLIST_DRY_RUN=
