# Copy to .env for local dev. NEVER commit real values (set them as Vercel env vars in prod).
# Server-side only — these are never exposed to the browser.
RESEND_API_KEY=re_placeholder_xxxxxxxxxxxxxxxxxxxx
RESEND_AUDIENCE_ID=00000000-0000-0000-0000-000000000000

# Public site URL (used for canonical/OG/sitemap). Safe to expose.
PUBLIC_SITE_URL=http://localhost:4321

# When "1", the waitlist endpoint skips the real Resend call and returns success.
# Used by e2e tests and local dev without credentials. Leave unset in production.
WAITLIST_DRY_RUN=
