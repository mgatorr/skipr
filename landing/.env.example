# Copy to .env for local dev. NEVER commit real values (set them as Vercel env vars in prod).
# The waitlist stores leads in our own Neon Postgres table (Vercel Marketplace).
# Vercel's Neon integration injects DATABASE_URL automatically in deployed envs.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Public site URL (used for canonical/OG/sitemap). Safe to expose.
PUBLIC_SITE_URL=http://localhost:4321

# When "1", the waitlist endpoint skips the real insert and returns success.
# Used by e2e tests and local dev without credentials. Leave unset in production.
WAITLIST_DRY_RUN=
